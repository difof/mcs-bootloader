# Copy settings through the project's configuration tasks. Your real .env is private.
# This is data: do not source it in a shell. $variables and $(commands) stay literal.
# Optional export, single-quoted literals, and JSON double-quoted strings are accepted.
# Put comments on their own line or after whitespace. Do not add RCON passwords here.
# The RCON credential stays in the protected file named by MC_RCON_PASSWORD_FILE.
# Omitted gateway settings retain their installed JSON values when applying changes.

# Network and protected runtime paths. RCON and the backend must stay on loopback.
# Backend/RCON addresses, credential path, unit, state directory, and socket must
# match the installed topology. config:apply refuses migrations of those fields.
MC_LISTEN=:25565
MC_BACKEND_ADDRESS=127.0.0.1:25566
MC_RCON_ADDRESS=127.0.0.1:25575
MC_RCON_PASSWORD_FILE=/etc/mc-gateway/rcon.password
MC_BACKEND_SERVICE=mc-gateway-backend.service
MC_STATE_DIRECTORY=/var/lib/mc-gateway
MC_ADMIN_SOCKET=/run/mc-gateway/control.sock

# Minecraft version and limits. Protocol 767 is Minecraft 1.21.1.
MC_PROTOCOL=767
MC_VERSION=1.21.1
MC_MAX_PLAYERS=5
MC_MAX_CONNECTIONS=64

# Go duration syntax, for example 1h, 15m, 30s, or 500ms.
MC_IDLE_TIMEOUT=1h
MC_POLL_INTERVAL=15s
MC_OPERATION_TIMEOUT=5s
MC_STARTUP_TIMEOUT=15m
MC_SHUTDOWN_WARN_AFTER=3m
MC_WAKE_COOLDOWN=30s
MC_HANDSHAKE_TIMEOUT=5s
MC_DIAL_TIMEOUT=3s

# Messages may contain JSON escapes such as \n for a line break.
MC_BOOT_MESSAGE="Server is booting up. Please reconnect in a few minutes."
MC_SLEEPING_MOTD="Server is sleeping. Join to start it."
MC_STARTING_MOTD="Server is booting up. Please wait..."
MC_FAILED_MOTD="Server is unavailable. Please try again shortly."
MC_LOG_LEVEL=info

# Task operation settings. These do not become gateway JSON fields.
MC_BINARY=/opt/mc-gateway/bin/mc-gateway
MC_CONFIG=/etc/mc-gateway/config.json
MC_SERVICE_USER=minecraft
MC_GATEWAY_SERVICE=mc-gateway.service
MC_LOG_NAMESPACE=mc-gateway
MC_LOG_LINES=100
MC_COMMAND_TIMEOUT=30s
