# mcs-bootloader init creates a private .env with a random password.
# mcs-bootloader config edit edits the selected file. Installation makes it
# the canonical /etc/mcs-bootloader/.env and links the original path to it.
# This file is data, never sourced: $variables and $(commands) stay literal.
# Use single-quoted literals or JSON double-quoted strings; no multiline values.

# Public gateway; backend and RCON must use the same numeric loopback host.
# Choose these before installation; later network/path changes need migration.
MC_LISTEN=:25565
MC_BACKEND_ADDRESS=127.0.0.1:25566
MC_RCON_ADDRESS=127.0.0.1:25575
MC_RCON_PASSWORD="replace-with-a-random-private-password"

# Existing Minecraft directory, executable, and literal argv (JSON array).
# Relative executable paths resolve inside MC_SERVER_DIRECTORY, never via PATH.
# Use the Java required by your pack. Scripts must stay in the foreground and
# must not restart Minecraft themselves. Startup edits need gateway restart.
MC_SERVER_DIRECTORY=/srv/minecraft
MC_LAUNCH_EXECUTABLE=/usr/bin/java
MC_LAUNCH_ARGS='["-jar","server.jar","nogui"]'

# This version supports Minecraft 1.21.1 / protocol 767.
MC_PROTOCOL=767
MC_VERSION=1.21.1
MC_MAX_PLAYERS=5
MC_MAX_CONNECTIONS=64

# Durations accept units such as 1h, 15m, 30s, 500ms.
MC_IDLE_TIMEOUT=15m
MC_POLL_INTERVAL=15s
MC_OPERATION_TIMEOUT=5s
MC_STARTUP_TIMEOUT=15m
MC_SHUTDOWN_WARN_AFTER=3m
MC_WAKE_COOLDOWN=30s
MC_HANDSHAKE_TIMEOUT=5s
MC_DIAL_TIMEOUT=3s
MC_RESTART_GRACE=3s

# Messages, timers, limits and log level support config reload .env.
# Restart reason is single-line; MOTDs/messages support JSON-escaped \n.
# Boot retry placeholders: {eta} gives the estimate; {elapsed} gives boot time so far.
MC_BOOT_MESSAGE="Server is booting up. {eta} Please reconnect."
MC_RESTART_MESSAGE="Gateway is restarting. Please reconnect in a moment."
# Whitelist policy comes from Minecraft's native files, not .env.
MC_WHITELIST_MESSAGE="You are not whitelisted on this server."
MC_SLEEPING_MOTD="Server is sleeping. Join to start it."
MC_STARTING_MOTD="Server is booting up. Please wait..."
MC_STOPPING_MOTD="Server is saving and going to sleep. Please reconnect shortly."
MC_UNKNOWN_MOTD="Checking server health. Please reconnect shortly."
MC_FAILED_MOTD="Server is unavailable. Please try again shortly."
MC_OVERRIDE_MOTD=false
MC_MOTD="Minecraft server"
MC_LOG_LEVEL=info

# Prometheus HTTP /metrics; separate listener, live-reloadable, off by default.
# No authentication: loopback is the safe default. Use a trusted scrape network
# or authenticated reverse proxy if remote Prometheus needs access.
# Scrapes use cached samples and never wake Minecraft or query RCON directly.
MC_METRICS_ENABLED=false
MC_METRICS_LISTEN=127.0.0.1:9464
MC_METRICS_POLL_INTERVAL=15s
# Per-player RCON health/food/XP/position details are sampled less frequently.
MC_METRICS_PLAYER_INTERVAL=60s
# Exposes current names/UUIDs, player details, and whitelist names/UUIDs.
MC_METRICS_PLAYER_DETAILS=true
# Named directories to measure, including worlds or backups. Absolute paths;
# the service account must be able to read them. Empty disables folder scans.
# Example: '{"world":"/srv/minecraft/world","backups":"/srv/backups"}'
MC_METRICS_DIRECTORIES='{}'
# Separate background scans; neither RCON polling nor HTTP scrapes wait on disk.
# Symlinks are skipped; incomplete scans keep last-good values with success=0.
MC_METRICS_DIRECTORY_INTERVAL=5m
MC_METRICS_DIRECTORY_TIMEOUT=30s

# Existing non-root account that owns Minecraft. The CLI uses sudo for private
# socket/service access. The daemon can only sudo-start its backend.
MC_SERVICE_USER=minecraft
MC_LOG_LINES=100
MC_COMMAND_TIMEOUT=30s

# Bundled single-instance installation paths. Keep these defaults for install.
MC_BACKEND_SERVICE=mcs-bootloader-backend.service
MC_STATE_DIRECTORY=/var/lib/mcs-bootloader
MC_ADMIN_SOCKET=/run/mcs-bootloader/control.sock
MC_BINARY=/opt/mcs-bootloader/bin/mcs-bootloader
MC_CONFIG=/etc/mcs-bootloader/.env
MC_GATEWAY_SERVICE=mcs-bootloader.service
MC_LOG_NAMESPACE=mcs-bootloader
