# First install: copy this to .env and fill in your private host settings.
# Installation makes project .env a symlink to /etc/mc-gateway/.env (0640).
# This is the only gateway config and credential file. Never commit the real .env.
# This is data: do not source it in a shell. $variables and $(commands) stay literal.
# Optional export, single-quoted literals, and JSON double-quoted strings are accepted.
# Put comments on their own line or after whitespace. Passwords must be 16-4096 bytes.
# task config:edit -> task config:check -> task config:apply (alias: task reload).
# Supported changes reload through the control socket; omitted fields use defaults.

# Network and protected runtime paths. RCON and the backend must stay on loopback.
# Listeners, backend unit, state directory, and socket must match the installation.
# config:apply rejects topology changes that require an installation migration.
MC_LISTEN=:25565
MC_BACKEND_ADDRESS=127.0.0.1:25566
MC_RCON_ADDRESS=127.0.0.1:25575
MC_RCON_PASSWORD="replace-with-a-random-private-password"
MC_BACKEND_SERVICE=mc-gateway-backend.service
MC_STATE_DIRECTORY=/var/lib/mc-gateway
MC_ADMIN_SOCKET=/run/mc-gateway/control.sock

# Minecraft startup settings. Use the exact existing modpack argument files.
# These require a gateway restart; Java uses the applied values at its next start.
MC_SERVER_DIRECTORY=/srv/minecraft
MC_JAVA_BINARY=/usr/bin/java
MC_JVM_ARGFILE=@user_jvm_args.txt
MC_SERVER_ARGFILE=@libraries/net/neoforged/neoforge/21.1.248/unix_args.txt

# Minecraft version and limits. Protocol 767 is Minecraft 1.21.1.
MC_PROTOCOL=767
MC_VERSION=1.21.1
MC_MAX_PLAYERS=5
MC_MAX_CONNECTIONS=64

# Go duration syntax, for example 1h, 15m, 30s, or 500ms.
MC_IDLE_TIMEOUT=1h
MC_POLL_INTERVAL=15s
MC_OPERATION_TIMEOUT=5s
MC_STARTUP_TIMEOUT=15m
MC_SHUTDOWN_WARN_AFTER=3m
MC_WAKE_COOLDOWN=30s
MC_HANDSHAKE_TIMEOUT=5s
MC_DIAL_TIMEOUT=3s

# Messages may contain JSON escapes such as \n for a line break.
MC_BOOT_MESSAGE="Server is booting up. Please reconnect in a few minutes."
MC_SLEEPING_MOTD="Server is sleeping. Join to start it."
MC_STARTING_MOTD="Server is booting up. Please wait..."
MC_FAILED_MOTD="Server is unavailable. Please try again shortly."
MC_LOG_LEVEL=info

# Task operation settings. MC_CONFIG must name the same file as project .env.
MC_BINARY=/opt/mc-gateway/bin/mc-gateway
MC_CONFIG=/etc/mc-gateway/.env
MC_SERVICE_USER=minecraft
MC_GATEWAY_SERVICE=mc-gateway.service
MC_LOG_NAMESPACE=mc-gateway
MC_LOG_LINES=100
MC_COMMAND_TIMEOUT=30s

# First-install backup destination, outside the Minecraft server directory.
MC_BACKUP_DIRECTORY=/srv/minecraft-backups/pre-gateway
