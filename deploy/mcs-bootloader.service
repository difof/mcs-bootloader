[Unit]
Description=Minecraft sleep and wake gateway
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=minecraft
Group=minecraft
WorkingDirectory=/
ExecStart=/opt/mcs-bootloader/bin/mcs-bootloader serve --config /etc/mcs-bootloader/.env
Restart=on-failure
RestartSec=5s
# The daemon bounds RCON notification and relay draining using its .env timers.
TimeoutStopSec=infinity
RuntimeDirectory=mcs-bootloader
RuntimeDirectoryMode=0700
StateDirectory=mcs-bootloader
StateDirectoryMode=0700
UMask=0077
PrivateTmp=true
ProtectSystem=full
# Read native whitelist files and same-account JVM metrics, including /home installs.
ProtectHome=read-only
# A narrowly scoped sudo rule starts only the backend unit.
# NoNewPrivileges would disable that rule.
NoNewPrivileges=false
LogNamespace=mcs-bootloader
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
