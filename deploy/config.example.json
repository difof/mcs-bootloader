{
  "listen": ":25565",
  "backend_address": "127.0.0.1:25566",
  "rcon_address": "127.0.0.1:25575",
  "rcon_password_file": "/etc/mc-gateway/rcon.password",
  "backend_service": "mc-gateway-backend.service",
  "state_directory": "/var/lib/mc-gateway",
  "admin_socket": "/run/mc-gateway/control.sock",
  "protocol": 767,
  "version": "1.21.1",
  "max_players": 5,
  "max_connections": 64,
  "idle_timeout": "1h",
  "poll_interval": "15s",
  "operation_timeout": "5s",
  "startup_timeout": "15m",
  "shutdown_warn_after": "3m",
  "wake_cooldown": "30s",
  "handshake_timeout": "5s",
  "dial_timeout": "3s",
  "boot_message": "Server is booting up. Please reconnect in a few minutes.",
  "sleeping_motd": "Server is sleeping. Join to start it.",
  "starting_motd": "Server is booting up. Please wait...",
  "failed_motd": "Server is unavailable. Please try again shortly.",
  "log_level": "info"
}
