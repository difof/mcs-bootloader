[Unit]
Description=Minecraft server managed by the sleep gateway
After=network.target

[Service]
Type=exec
User=minecraft
Group=minecraft
WorkingDirectory=/
# Launch the configured executable and literal argv in the server directory.
ExecStart=/opt/mcs-bootloader/bin/mcs-bootloader backend-start --config /etc/mcs-bootloader/.env
ExecStop=/opt/mcs-bootloader/bin/mcs-bootloader backend-stop --config /etc/mcs-bootloader/.env --pid=${MAINPID}
Restart=no
TimeoutStopSec=infinity
# If the helper fails, leave the process alive for operator recovery.
KillSignal=SIGCONT
SendSIGKILL=no
KillMode=control-group
UMask=0027
LogNamespace=mcs-bootloader
LogRateLimitIntervalSec=30s
LogRateLimitBurst=5000
# Intentionally no Install section: waking is explicit, not automatic at boot.
